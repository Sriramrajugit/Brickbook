generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Company {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  auditRetentionDays  Int                  @default(365)
  demoExpiryDate      DateTime?
  demoStartedAt       DateTime?
  isDemoAccount       Boolean              @default(false)
  package             CustomerPackage      @default(FOUNDATION)
  accounts            Account[]
  advances            Advance[]
  attendances         Attendance[]
  audits              Audit[]
  categories          Category[]
  employees           Employee[]
  grns                GoodsReceivedNote[]
  items               Item[]
  partnerBillPayments PartnerBillPayment[]
  partnerBills        PartnerBill[]
  partners            Partner[]
  payrolls            Payroll[]
  purchaseOrderAudits PurchaseOrderAudit[]
  purchaseOrders      PurchaseOrder[]
  sites               Site[]
  suppliers           Supplier[]
  transactions        Transaction[]
  users               User[]

  @@map("companies")
}

model Site {
  id           Int           @id @default(autoincrement())
  name         String
  location     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  companyId    Int
  accounts     Account[]
  company      Company       @relation(fields: [companyId], references: [id])
  transactions Transaction[]
  users        User[]

  @@unique([name, companyId])
  @@index([companyId])
  @@map("sites")
}

model User {
  id                    Int                  @id @default(autoincrement())
  email                 String?              @unique
  name                  String?
  password              String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  logoutTime            DateTime?
  role                  UserRole             @default(GUEST)
  siteId                Int?
  companyId             Int
  status                String               @default("Active")
  loginTime             DateTime?
  audits                Audit[]
  auditLogs             PurchaseOrderAudit[]
  purchaseOrdersCreated PurchaseOrder[]      @relation("POCreatedBy")
  transactions          Transaction[]
  company               Company              @relation(fields: [companyId], references: [id])
  site                  Site?                @relation(fields: [siteId], references: [id])

  @@index([companyId])
  @@map("users")
}

model Account {
  id            Int           @id @default(autoincrement())
  name          String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  budget        Float         @default(0)
  type          String        @default("General")
  siteId        Int?
  endDate       DateTime?
  startDate     DateTime?
  companyId     Int
  projectStatus String?       @default("Yet to start")
  address       String?
  city          String?
  state         String?
  zip           String?
  company       Company       @relation(fields: [companyId], references: [id])
  site          Site?         @relation(fields: [siteId], references: [id])
  partnerBills  PartnerBill[]
  transactions  Transaction[]

  @@index([companyId])
  @@map("accounts")
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  companyId    Int
  company      Company       @relation(fields: [companyId], references: [id])
  transactions Transaction[]

  @@unique([name, companyId])
  @@index([companyId])
  @@map("categories")
}

model Transaction {
  id            Int       @id @default(autoincrement())
  amount        Float
  description   String?
  category      String
  type          String
  date          DateTime
  accountId     Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  categoryId    Int?
  paymentMode   String    @default("G-Pay")
  createdBy     Int?
  companyId     Int
  siteId        Int?
  advances      Advance[]
  account       Account   @relation(fields: [accountId], references: [id])
  categoryRef   Category? @relation(fields: [categoryId], references: [id])
  company       Company   @relation(fields: [companyId], references: [id])
  createdByUser User?     @relation(fields: [createdBy], references: [id])
  site          Site?     @relation(fields: [siteId], references: [id])

  @@index([companyId])
  @@index([siteId])
  @@map("transactions")
}

model Employee {
  id               Int           @id @default(autoincrement())
  name             String
  etype            String?
  salary           Float?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  status           String        @default("Active")
  companyId        Int
  address          String?
  creditPeriodDays Int           @default(30)
  email            String?
  gstNumber        String?
  isActive         Boolean       @default(true)
  partnerType      String        @default("Employee")
  phone            String?
  salaryFrequency  String        @default("Monthly")
  advances         Advance[]
  attendances      Attendance[]
  company          Company       @relation(fields: [companyId], references: [id])
  partnerBills     PartnerBill[]
  payrolls         Payroll[]

  @@map("employees")
}

model Attendance {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime
  status     Float
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendances")
}

model Payroll {
  id         Int      @id @default(autoincrement())
  employeeId Int
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  accountId  Int
  fromDate   DateTime
  toDate     DateTime
  remarks    String?
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@map("payrolls")
}

model Advance {
  id            Int          @id @default(autoincrement())
  amount        Float
  reason        String?
  date          DateTime
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  employeeId    Int
  companyId     Int
  transactionId Int?
  company       Company      @relation(fields: [companyId], references: [id])
  employee      Employee     @relation(fields: [employeeId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([transactionId])
  @@map("advances")
}

model Supplier {
  id             Int             @id @default(autoincrement())
  name           String
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  companyId      Int
  purchaseOrders PurchaseOrder[]
  company        Company         @relation(fields: [companyId], references: [id])
  items          Item[]          @relation("ItemToSupplier")

  @@index([companyId])
  @@map("suppliers")
}

model Item {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  category     String?
  unit         String     @default("Bag")
  openingStock Float      @default(0)
  currentStock Float      @default(0)
  reorderLevel Float?
  defaultRate  Float?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  companyId    Int
  company      Company    @relation(fields: [companyId], references: [id])
  suppliers    Supplier[] @relation("ItemToSupplier")

  @@index([companyId])
  @@map("items")
}

model PurchaseOrder {
  id             Int                  @id @default(autoincrement())
  poNumber       String               @unique
  date           DateTime             @default(now())
  status         String               @default("DRAFT")
  supplierId     Int
  vendorName     String
  vendorContact  String?
  vendorAddress  String?
  vendorPhone    String?
  shipToName     String
  shipToAddress  String?
  shipToCity     String?
  shipToState    String?
  shipToZip      String?
  requisitioner  String?
  shipVia        String?
  fob            String?
  shippingTerms  String?
  comments       String?
  subtotal       Float                @default(0)
  taxAmount      Float                @default(0)
  shippingAmount Float                @default(0)
  otherAmount    Float                @default(0)
  totalAmount    Float                @default(0)
  createdById    Int
  companyId      Int
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  grns           GoodsReceivedNote[]
  auditLogs      PurchaseOrderAudit[]
  items          PurchaseOrderItem[]
  company        Company              @relation(fields: [companyId], references: [id])
  createdByUser  User                 @relation("POCreatedBy", fields: [createdById], references: [id])
  supplier       Supplier             @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([companyId])
  @@index([createdById])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            Int                     @id @default(autoincrement())
  poId          Int
  itemCode      String?
  description   String
  quantity      Float
  unitOfMeasure String?                 @default("Pcs")
  specification String?
  unitPrice     Float
  totalPrice    Float
  remarks       String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  grnItems      GoodsReceivedNoteItem[]
  purchaseOrder PurchaseOrder           @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@map("purchase_order_items")
}

model PurchaseOrderAudit {
  id            Int           @id @default(autoincrement())
  poId          Int
  userId        Int
  action        String
  fieldChanged  String?
  oldValue      String?
  newValue      String?
  description   String
  companyId     Int
  createdAt     DateTime      @default(now())
  company       Company       @relation(fields: [companyId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])

  @@index([poId])
  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
  @@map("purchase_order_audits")
}

model GoodsReceivedNote {
  id                  Int                     @id @default(autoincrement())
  grnNumber           String                  @unique
  poId                Int
  status              String                  @default("DRAFT")
  receivedDate        DateTime                @default(now())
  warehouseLocation   String?
  receivedBy          String?
  verifiedBy          String?
  transporterName     String?
  trackingNumber      String?
  deliveryNotes       String?
  totalReceivedAmount Float                   @default(0)
  discrepancies       String?
  companyId           Int
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  items               GoodsReceivedNoteItem[]
  company             Company                 @relation(fields: [companyId], references: [id])
  purchaseOrder       PurchaseOrder           @relation(fields: [poId], references: [id])

  @@index([poId])
  @@index([companyId])
  @@map("goods_received_notes")
}

model GoodsReceivedNoteItem {
  id               Int               @id @default(autoincrement())
  grnId            Int
  poItemId         Int
  quantityOrdered  Float
  quantityReceived Float
  quantityRejected Float             @default(0)
  quantityAccepted Float
  description      String
  unitPrice        Float
  receivedAmount   Float
  batchNumber      String?
  expiryDate       DateTime?
  condition        String?
  qcNotes          String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  grn              GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItem           PurchaseOrderItem @relation(fields: [poItemId], references: [id])

  @@index([grnId])
  @@index([poItemId])
  @@map("goods_received_note_items")
}

model Partner {
  id               Int      @id @default(autoincrement())
  name             String
  email            String?
  phone            String?
  address          String?
  partnerType      String
  gstNumber        String?
  creditPeriodDays Int      @default(30)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("partners")
}

model PartnerBill {
  id            Int                  @id @default(autoincrement())
  companyId     Int
  employeeId    Int
  accountId     Int
  invoiceNo     String
  billDate      DateTime
  dueDate       DateTime?
  amount        Float
  paidAmount    Float                @default(0)
  status        BillStatus           @default(UNPAID)
  billImagePath String?
  remarks       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  payments      PartnerBillPayment[]
  account       Account              @relation(fields: [accountId], references: [id])
  company       Company              @relation(fields: [companyId], references: [id])
  employee      Employee             @relation(fields: [employeeId], references: [id])

  @@unique([companyId, employeeId, invoiceNo])
  @@index([companyId])
  @@index([employeeId])
  @@index([accountId])
  @@index([status])
  @@map("partner_bills")
}

model PartnerBillPayment {
  id            Int         @id @default(autoincrement())
  companyId     Int
  billId        Int
  paymentDate   DateTime
  amount        Float
  paymentMode   PaymentMode @default(GPAY)
  referenceNo   String?
  transactionId Int?
  createdAt     DateTime    @default(now())
  bill          PartnerBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  company       Company     @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([billId])
  @@map("partner_bill_payments")
}

model Audit {
  id          Int      @id @default(autoincrement())
  companyId   Int
  module      String
  action      String
  recordId    Int?
  userId      Int
  beforeData  Json?
  afterData   Json?
  description String
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([module])
  @@index([action])
  @@index([userId])
  @@index([recordId])
  @@index([timestamp])
  @@map("audits")
}

enum UserRole {
  OWNER
  SITE_MANAGER
  GUEST
}

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  FULLY_PAID
}

enum PaymentMode {
  GPAY
  BANK_TRANSFER
  CASH
  CHEQUE
  UPI
  NEFT
  RTGS
  IMPS
}

enum CustomerPackage {
  FOUNDATION
  STRUCTURE
  LANDMARK
  DEMO
}
